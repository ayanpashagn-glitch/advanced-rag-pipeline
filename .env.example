# Local inference (default). No paid API or API key required.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=mxbai-embed-large
DATA_DIR=data
# Optional hosted generation. Embeddings still use local Ollama.
# AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# AI_PROVIDER=evidence disables AI explicitly, for UI/document inspection only.
